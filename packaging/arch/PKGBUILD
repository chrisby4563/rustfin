# Rustfin – builds the latest committed state of this repository:
#   cd packaging/arch && makepkg -si
pkgname=rustfin
pkgver=0.4.8.r475.g3da69b9
pkgrel=1
pkgdesc="Jellyfin client (Rust/GTK4/mpv), fork of Delfin with SyncPlay, filters, chapters and more"
arch=('x86_64')
url="https://github.com/chrisby4563/rustfin"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'mpv' 'libepoxy' 'openssl' 'glib2' 'gst-plugins-bad-libs' 'gst-plugins-base-libs')
makedepends=('git' 'meson' 'cargo' 'appstream')
replaces=('delfin-chrisby')
conflicts=('delfin-chrisby')
options=('!lto' '!debug')
source=("delfin::git+file://${startdir}/../..#branch=chrisby")
sha256sums=('SKIP')

pkgver() {
  cd delfin
  printf "0.4.8.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd delfin
  # Fetch Rust dependencies in advance (so the build can run without a network).
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  # Build directory INSIDE the clone: cargo searches upward for Cargo.toml,
  # and would otherwise build the ~/projects/delfin working directory.
  cd delfin
  arch-meson . _pkgbuild -Dprofile=release
  meson compile -C _pkgbuild
}

package() {
  meson install -C delfin/_pkgbuild --no-rebuild --destdir "$pkgdir"
}
